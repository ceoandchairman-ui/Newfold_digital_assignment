# Copy to .env for local development. Never commit .env.
# Production: secrets come from Key Vault as environment variables, and Postgres and Redis use Entra
# tokens, so most of the values below are not needed there.
DATABASE_URL=postgresql://support:support@localhost:5432/support
# Three Redis clusters, one per purpose (D9). Use rediss:// (TLS) in Azure.
REDIS_URL=redis://localhost:6379/0               # cache: conversation window, verified flag
CHECKPOINT_REDIS_URL=redis://localhost:6379/1    # LangGraph checkpoints, graph state, run locks
TOOL_CACHE_REDIS_URL=redis://localhost:6379/2    # tool-call results (unset to disable)
CHECKPOINT_TTL_MINUTES=1440

DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
REDIS_WINDOW_SIZE=20
REDIS_SESSION_TTL_S=1800
HISTORY_DAYS=5               # earlier conversations offered on a session's first turn (0 = off)
HISTORY_MAX_SESSIONS=5

EMBEDDING_MODEL=text-embedding-3-large   # also the Azure deployment name; uses AZURE_OPENAI_ENDPOINT below
EMBEDDING_DIM=1024
RERANK_ENABLED=false
RERANKER_URL=
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# The retrieval service (search + reranker) and how long a caller waits for one attempt.
RETRIEVAL_URL=http://retrieval:8000
# Secret that hashes session and customer ids in logs. The same value in every service. In Azure,
# Terraform generates it and Key Vault delivers it. Unset = unkeyed hashes (local use only).
LOG_HASH_KEY=
RETRIEVAL_TIMEOUT_SECONDS=8
# "Today" for billing and contract rules. The supplied policy fixes it at 2025-02-25; set this
# only when running on that data. Leave unset in production.
BUSINESS_DATE=

# The metadata registry (Azure Cosmos DB, Entra auth only: there is no key to set). Unset = no
# registry. Production sets REGISTRY_REQUIRED=true.
COSMOS_ENDPOINT=
COSMOS_DATABASE=registry
REGISTRY_REQUIRED=false
# Raise to embed every document again with the same model name.
EMBEDDING_VERSION=1
# Cosine similarity a vector match needs (-1 to 1). Leave unset until measured on the real embedder.
# RETRIEVAL_MIN_SIMILARITY=

# --- Models: one deployment per job (see docs/01_setup_and_run.md) -----------------------------------
# Production uses Managed Identity; set the endpoint only where a real deployment exists.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview        # PLACEHOLDER, unverified: the agents
AZURE_OPENAI_CHAT_API_VERSION=2025-04-01-preview   # PLACEHOLDER, unverified: the query rewrite
LLM_CHAT_DEPLOYMENT=chat-support
LLM_CHAT_EFFORT=low
LLM_PLANNER_DEPLOYMENT=chat-planner
LLM_PLANNER_EFFORT=medium
LLM_REWRITE_DEPLOYMENT=chat-rewrite
LLM_REWRITE_EFFORT=minimal
LLM_TROUBLESHOOTER_DEPLOYMENT=chat-troubleshooter
LLM_TROUBLESHOOTER_EFFORT=medium
LLM_JUDGE_DEPLOYMENT=chat-judge
LLM_JUDGE_EFFORT=low
# If a role's deployment fails or times out, this one answers instead (empty = no fallback).
LLM_CHAT_FALLBACK_DEPLOYMENT=chat-planner
LLM_PLANNER_FALLBACK_DEPLOYMENT=chat-support
LLM_TROUBLESHOOTER_FALLBACK_DEPLOYMENT=chat-planner
TROUBLESHOOTER_TOOL_STEPS=3
ONLINE_JUDGE_ENABLED=true

# --- Security ---------------------------------------------------------------------------------------------
MIN_SESSION_ID_LENGTH=32           # a session id is a bearer token: long and random (0 = off, tests only)
VERIFY_MAX_FAILURES_SESSION=5      # failed identity checks before a lockout, per session
VERIFY_MAX_FAILURES_SUBJECT=10     # ... per person being guessed (phone or name)
VERIFY_MAX_FAILURES_IP=30          # ... per caller address
VERIFY_WINDOW_SECONDS=900          # the lockout lasts until the window ends
CHAT_RATE_PER_MINUTE=30            # per customer
IP_RATE_PER_MINUTE=120             # per caller address
TRUSTED_PROXY_HOPS=0               # reverse proxies in front of the API; X-Forwarded-For is ignored at 0

# --- Resilience -----------------------------------------------------------------------------------------------
MAX_INFLIGHT_TURNS=64              # per backend pod, then a fast 503 with Retry-After
TURN_TIMEOUT_SECONDS=45            # a whole graph run for one message (a payment resume is exempt)
AGENT_CIRCUIT_THRESHOLD=5          # failures in a row before an agent is cut off
AGENT_CIRCUIT_COOLDOWN_SECONDS=30
LLM_TIMEOUT_SECONDS=30             # one model call, then its fallback
REWRITE_TIMEOUT_SECONDS=1.5
JUDGE_TIMEOUT_SECONDS=4
IDEMPOTENCY_TTL_SECONDS=300

# --- Third-party providers: PLACEHOLDERS, all default to stubs ------------------------------------------------
MCP_TRANSPORT=http
USE_STUB_SMS=true
USE_STUB_EMAIL=true
USE_STUB_GATEWAY=true              # false = Stripe, needs STRIPE_SECRET_KEY
USE_STUB_TWILIO=true
USE_STUB_GMAIL=true
USE_STUB_DRIVE=true
SMS_PROVIDER=acs                   # acs or twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_CHANNEL_ENABLED=false
TWILIO_WEBHOOK_URL=                # the exact public URL Twilio calls: used to check its signature
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd
GOOGLE_CREDENTIALS_JSON=
GOOGLE_SUPPORT_MAILBOX=
GOOGLE_DRIVE_FOLDER_ID=
