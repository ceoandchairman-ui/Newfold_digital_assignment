.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
# scratch folders and logs from local test runs (can hold throwaway keys): never commit them
.tmp_work/
.tmp_out.txt

# docs: only publish the three submission docs
docs/*
!docs/01_setup_and_run.md
!docs/02_design_note.md
!docs/03_tests_and_examples.md

# terraform: state and plans can contain secrets; providers are downloaded on init
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
